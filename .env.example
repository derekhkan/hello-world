# OpenAI API key for resume/cover letter tailoring
OPENAI_API_KEY=sk-your-key-here

# LinkedIn credentials (for automated applications)
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=your-password

# Indeed credentials
INDEED_EMAIL=your-email@example.com
INDEED_PASSWORD=your-password

# Glassdoor credentials
GLASSDOOR_EMAIL=your-email@example.com
GLASSDOOR_PASSWORD=your-password

# ZipRecruiter credentials
ZIPRECRUITER_EMAIL=your-email@example.com
ZIPRECRUITER_PASSWORD=your-password

# Notification settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@example.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=your-email@example.com

# Encryption key for stored credentials (auto-generated on first run)
ENCRYPTION_KEY=
