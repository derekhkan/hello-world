# ─── Midjourney / Image Generation ───────────────────────────────
# API URL for your Midjourney proxy (GoAPI, ImagineAPI, etc.)
MIDJOURNEY_API_URL=https://api.midjourney.com
# API key / bearer token
MIDJOURNEY_API_KEY=
# Default parameters appended to every prompt
MIDJOURNEY_DEFAULT_PARAMS=--ar 9:16 --style raw --v 6
# Timeout in seconds for image generation
MIDJOURNEY_TIMEOUT=120

# ─── Video Assembly ──────────────────────────────────────────────
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_DURATION_PER_IMAGE=3.0
VIDEO_TRANSITION_DURATION=0.5
VIDEO_MAX_DURATION=59.0
# edge-tts voice (see: https://github.com/rany2/edge-tts)
VIDEO_TTS_VOICE=en-US-ChristopherNeural

# ─── YouTube Upload ──────────────────────────────────────────────
# Path to your OAuth2 client_secrets.json from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
# Cached token file (created after first auth)
YOUTUBE_TOKEN_FILE=token.json
# Video category: 22 = People & Blogs, 24 = Entertainment, 28 = Science & Technology
YOUTUBE_CATEGORY_ID=22
# Privacy: public, unlisted, or private
YOUTUBE_PRIVACY_STATUS=public

# ─── General ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
